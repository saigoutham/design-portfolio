{
  "about": "What must exist before a visual is shown. `npm run gate -- <site> <gate>` checks it; a failing gate means don't show, do the missing steps. Skills count only if docs/decisions.md has a `ran` line naming them.",
  "animatic": {
    "skills": ["hyperframes", "r3f-materials", "r3f-shaders", "r3f-lighting", "r3f-postprocessing", "library/motionsites", "library/scroll-craft"],
    "files": [
      { "glob": "docs/council/*art-route*.md", "min": 1, "why": "council verdict on the art route" },
      { "glob": "docs/critics/animatic-*.md", "min": 3, "why": "3 independent critics on the frames" },
      { "glob": "animatic/REVIEW.md", "min": 1, "why": "hyperframes review" },
      { "glob": "docs/film/animatic-v*.mp4", "min": 1, "why": "the rendered film" }
    ],
    "pass": { "glob": "docs/critics/animatic-*.md", "pattern": "VERDICT: PASS", "min": 2, "why": "at least 2 of 3 critics pass it" }
  },
  "hero": {
    "skills": ["gsap-scrolltrigger", "gsap-react", "impeccable", "jury"],
    "files": [
      { "glob": "docs/critics/hero-*.md", "min": 3, "why": "3 independent critics" },
      { "glob": ".jury/*/critic.md", "min": 1, "why": "blind jury critic" }
    ],
    "pass": { "glob": "docs/critics/hero-*.md", "pattern": "VERDICT: PASS", "min": 2, "why": "at least 2 of 3 critics pass it" }
  }
}
